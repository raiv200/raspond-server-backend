generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ORGANIZATION (one per user — created during onboarding) ──

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrgMember[]
  invites OrgInvite[]
  rfps    Rfp[]
  tags    Tag[]
}

// ─── ORG MEMBERSHIP ───────────────────────────────────────────

model OrgMember {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole  @default(TEAM_MEMBER)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// ─── ORG INVITE ───────────────────────────────────────────────

model OrgInvite {
  id        String       @id @default(cuid())
  orgId     String
  email     String?
  code      String       @unique @default(cuid())
  role      OrgRole      @default(TEAM_MEMBER)
  status    InviteStatus @default(PENDING)
  invitedBy String
  expiresAt DateTime
  createdAt DateTime     @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([email, orgId])
}

// ─── USER ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  avatar        String?
  title         String?
  color         String    @default("#3B82F6")
  emailVerified Boolean   @default(false)
  verifyOtp     String?
  verifyExpires DateTime?
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships        OrgMember[]
  rfpsCreated        Rfp[]               @relation("RfpCreator")
  rfpMembers         RfpMember[]
  sectionAccess      SectionAccess[]
  sectionAssignments SectionAssignment[]
  approvals          Approval[]
  globalApprovals    RfpGlobalApprover[]
  submissions        Submission[]
  documents           documents[]
  createdTags         Tag[]              @relation("TagCreator")
  createdDocumentTags document_tags[]    @relation("DocumentTagCreator")
}

// ─── RFP ──────────────────────────────────────────────────────

model Rfp {
  id             String    @id @default(cuid())
  title          String
  description    String?
  company        String?
  dueDate        DateTime?
  estimatedValue Float?
  status         RfpStatus @default(DRAFT)
  orgId          String
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation("RfpCreator", fields: [createdById], references: [id])

  sections        Section[]
  members         RfpMember[]
  approvals       Approval[]
  globalApprovers RfpGlobalApprover[]
  submission      Submission?
}

// ─── RFP MEMBERSHIP (who can see this RFP) ────────────────────

model RfpMember {
  id        String   @id @default(cuid())
  userId    String
  rfpId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rfp  Rfp  @relation(fields: [rfpId], references: [id], onDelete: Cascade)

  @@unique([userId, rfpId])
}

// ─── SECTIONS & QUESTIONS ─────────────────────────────────────

model Section {
  id        String   @id @default(cuid())
  rfpId     String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfp         Rfp                 @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  questions   Question[]
  access      SectionAccess[]
  assignments SectionAssignment[]
  approvals   Approval[]
}

model Question {
  id           String    @id @default(cuid())
  sectionId    String
  title        String
  fullQuestion String
  description  String?
  order        Int
  maxChars     Int       @default(3000)
  answer       String?   @db.Text
  answerJson   String?   @db.Text
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

// ─── SECTION ACCESS (which team members can see/edit a section) ─

model SectionAccess {
  id        String             @id @default(cuid())
  sectionId String
  userId    String
  permission SectionPermission @default(EDIT)
  createdAt DateTime           @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectionId, userId])
}

// ─── SECTION ASSIGNMENTS (writers + approvers) ────────────────

model SectionAssignment {
  id        String               @id @default(cuid())
  sectionId String
  userId    String
  role      SectionAssignmentRole @default(WRITER)
  order     Int                  @default(0)
  createdAt DateTime             @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectionId, userId, role])
}

// ─── APPROVAL TRACKING ────────────────────────────────────────

model Approval {
  id        String         @id @default(cuid())
  rfpId     String
  sectionId String?
  userId    String
  status    ApprovalStatus @default(PENDING)
  notes     String?        @db.Text
  order     Int            @default(0)
  decidedAt DateTime?
  createdAt DateTime       @default(now())

  rfp     Rfp      @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rfpId, sectionId, userId])
}

// ─── RFP GLOBAL APPROVERS ─────────────────────────────────────

model RfpGlobalApprover {
  id     String @id @default(cuid())
  rfpId  String
  userId String
  order  Int    @default(0)

  rfp  Rfp  @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rfpId, userId])
}

// ─── SUBMISSION RECORD ────────────────────────────────────────

model Submission {
  id                 String   @id @default(cuid())
  rfpId              String   @unique
  submittedById      String
  submissionMethod   String?
  recipientEmail     String?
  submissionBody     String?  @db.Text
  exportFormat       String?
  totalTimeMinutes   Int?
  aiSuggestionsCount Int?
  contributorsCount  Int?
  submittedAt        DateTime @default(now())

  rfp         Rfp  @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  submittedBy User @relation(fields: [submittedById], references: [id])
}

// ─── ENUMS ────────────────────────────────────────────────────

enum OrgRole {
  BID_MANAGER
  BID_EXECUTIVE
  TEAM_MEMBER
}

enum RfpStatus {
  DRAFT
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  SUBMITTED
  ARCHIVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SectionPermission {
  VIEW
  EDIT
}

enum SectionAssignmentRole {
  WRITER
  APPROVER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

// ─── DOCUMENTS & AI PROCESSING ────────────────────────────────

enum documentstatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

model documents {
  id                  String                @id @db.Uuid
  org_id              String
  workspace_id        String?
  filename            String
  file_type           String
  s3_url              String
  status              String
  created_by          String?
  user                User?                 @relation(fields: [created_by], references: [id])
  version             Int?
  created_at          DateTime?             @db.Timestamp(6)
  updated_at          DateTime?             @db.Timestamp(6)
  document_blocks     document_blocks[]
  document_chunks     document_chunks[]
  document_pages      document_pages[]
  document_parse_runs document_parse_runs[]
  document_tags       document_tags[]
}

model document_chunks {
  id               String             @id @db.Uuid
  document_id      String             @db.Uuid
  block_ids        String[]           @db.Uuid
  chunk_text       String
  token_count      Int?
  chunk_index      Int?
  created_at       DateTime?          @db.Timestamp(6)
  chunk_embeddings chunk_embeddings[]
  documents        documents          @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model chunk_embeddings {
  id              String          @id @db.Uuid
  chunk_id        String          @db.Uuid
  embedding_model String
  vector_id       String
  namespace       String
  created_at      DateTime?       @db.Timestamp(6)
  deleted_at      DateTime?       @db.Timestamp(6)
  document_chunks document_chunks @relation(fields: [chunk_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model document_blocks {
  id                  String              @id @db.Uuid
  document_id         String              @db.Uuid
  parse_run_id        String              @db.Uuid
  page_number         Int
  order_index         Int
  block_type          String
  content             String
  bbox                Json?
  confidence          Float?
  metadata            Json?
  created_at          DateTime?           @db.Timestamp(6)
  documents           documents           @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_parse_runs document_parse_runs @relation(fields: [parse_run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model document_pages {
  id           String    @id @db.Uuid
  document_id  String    @db.Uuid
  page_number  Int
  text_density Float?
  ocr_required Boolean?
  created_at   DateTime? @db.Timestamp(6)
  documents    documents @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model document_parse_runs {
  id              String            @id @db.Uuid
  document_id     String            @db.Uuid
  parser_version  String
  ocr_used        Boolean?
  status          String
  error_message   String?
  started_at      DateTime?         @db.Timestamp(6)
  completed_at    DateTime?         @db.Timestamp(6)
  created_at      DateTime?         @db.Timestamp(6)
  document_blocks document_blocks[]
  documents       documents         @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── TAGS ─────────────────────────────────────────────────────

model Tag {
  id           String        @id @default(cuid())
  orgId        String        @map("org_id")
  organisation Organization  @relation(fields: [orgId], references: [id])
  header       String
  subheader    String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  createdBy    String?       @map("created_by")
  creator      User?         @relation("TagCreator", fields: [createdBy], references: [id])
  documentTags document_tags[]

  @@map("tags")
}

model document_tags {
  id         String    @id @default(cuid())
  documentId String    @map("document_id") @db.Uuid
  tagId      String    @map("tag_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")

  document   documents @relation(fields: [documentId], references: [id])
  tag        Tag       @relation(fields: [tagId], references: [id])
  creator    User?     @relation("DocumentTagCreator", fields: [createdBy], references: [id])

  @@map("document_tags")
}
